Deploy:
  Git:
    # git 可执行文件。
    # 默认使用 PATH 中的 git。
    GitExecutable: 'git'

  Python:
    # Python 可执行文件。
    # uv 环境默认使用 './.venv/Scripts/python.exe'。
    PythonExecutable: './.venv/Scripts/python.exe'

  Adb:
    # ADB 可执行文件。
    # uv 环境默认使用 adbutils 自带的 adb.exe。
    AdbExecutable: './.venv/Lib/site-packages/adbutils/binaries/adb.exe'
    # 是否替换 MuMu 目录内的 ADB。
    ReplaceAdb: true
    # 是否自动连接 MuMu 实例。
    AutoConnect: true
    # 是否重新安装 uiautomator2。
    InstallUiautomator2: true

  Ocr:
    # 是否把 OCR 作为服务运行，减少多实例重复加载 OCR 的内存占用。

    # 是否使用 OCR 服务。
    UseOcrServer: false
    # 是否在启动 WebUI 时启动 OCR 服务。
    StartOcrServer: false
    # WebUI 启动的 OCR 服务端口。
    OcrServerPort: 22268
    # Alas 实例连接 OCR 服务的地址。
    OcrClientAddress: 127.0.0.1:22268

  Misc:
    # 是否启用 Discord 状态展示。
    DiscordRichPresence: false

  Webui:
    # WebUI 监听地址，默认只允许本机访问。
    WebuiHost: 127.0.0.1
    # WebUI 监听端口。
    WebuiPort: 22267
    # WebUI 主题，default 为亮色，dark 为暗色。
    Theme: default
    # 是否跟随系统 DPI 缩放。
    DpiScaling: true
    # WebUI 密码，默认不启用。
    Password: null
    # 是否用 jsdelivr 加载 pywebio 静态文件，false 表示本地提供。
    CDN: false
    # 启动 WebUI 时自动运行的配置名。
    # null 表示不自动运行；'["alas"]' 表示自动运行 alas。
    Run: null
